{
  "name": "ai-cloud-removal-personal",
  "version": "5.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/start-personal.mjs --production",
    "start:cloudflare": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify": "node --experimental-strip-types scripts/verify-analysis.mjs",
    "verify:access": "node scripts/verify-access.mjs",
    "dev:next": "node scripts/run-next.mjs dev",
    "build:next": "node scripts/run-next.mjs build",
    "start:next": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test:frontend": "vitest run --config vitest.config.ts",
    "personal": "node scripts/start-personal.mjs",
    "worker:build": "node scripts/build-personal-worker.mjs",
    "db:local": "node scripts/prepare-local-d1.mjs",
    "dev:cloudflare": "node scripts/run-framework.mjs dev-cloudflare",
    "verify:personal": "node scripts/verify-personal.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fast-png": "^8.0.0",
    "framer-motion": "^13.4.0",
    "geotiff": "^3.0.5",
    "input-otp": "^1.4.2",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "proj4": "^2.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/proj4": "^2.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^5.0.1",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
