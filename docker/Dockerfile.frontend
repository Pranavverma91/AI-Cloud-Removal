FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ENV SPACE_EYE_STANDALONE=true NEXT_TELEMETRY_DISABLED=1
RUN pnpm build:next
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production SPACE_EYE_STANDALONE=true HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1 PERSONAL_DATA_DIR=/app/data/personal
COPY --from=build --chown=node:node /app/frontend/.next-personal/standalone ./
COPY --from=build --chown=node:node /app/frontend/.next-personal/static ./frontend/.next-personal/static
COPY --from=build --chown=node:node /app/frontend/public ./frontend/public
RUN mv frontend/server.js frontend/server.cjs && mkdir -p /app/data/personal && chown -R node:node /app/data
USER node
EXPOSE 3000
CMD ["node", "frontend/server.cjs"]
